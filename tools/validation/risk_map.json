{
 "schema_version": "3diwell-risk-map-v1",
 "description": "Единый источник правды: изменённый путь -> область -> риск R0..R4 -> минимальный профиль проверки. Правила упорядочены, но НЕ действует принцип 'первое совпадение победило': совпавшие правила объединяются, берётся МАКСИМАЛЬНЫЙ риск, САМЫЙ СТРОГИЙ профиль и объединение всех обязательных признаков. Занижать риск ради скорости запрещено.",
 "risk_order": [
  "R0",
  "R1",
  "R2",
  "R3",
  "R4"
 ],
 "profile_order": [
  "FAST",
  "TARGETED",
  "SUBSYSTEM",
  "RELEASE",
  "HARDWARE"
 ],
 "profile_min_by_risk": {
  "R0": "FAST",
  "R1": "TARGETED",
  "R2": "SUBSYSTEM",
  "R3": "RELEASE",
  "R4": "RELEASE"
 },
 "fallback": {
  "unknown_product_file": {
   "component": "unknown",
   "risk": "R3",
   "profile": "RELEASE",
   "blocked": false,
   "reason": "unknown product path — путь не описан в карте; занижать до FAST нельзя, эскалация до RELEASE",
   "warning": "Файл не совпал ни с одним правилом. Добавьте правило в tools/validation/risk_map.json."
  },
  "unknown_in_critical_area": {
   "component": "unknown-critical",
   "risk": "R4",
   "profile": "RELEASE",
   "blocked": true,
   "reason": "unknown path inside critical area — неизвестный файл внутри критической области; автоматический выбор профиля запрещён",
   "warning": "Неизвестный путь в критической области. Требуется явное решение владельца и запись правила в карту."
  },
  "critical_area_globs": [
   "app/print*",
   "app/project_orchestrator.py",
   "app/printer_files/**",
   "app/config_backup/**",
   "app/klipper_*",
   "app/printer_command_policy.py",
   "app/printer_job_lifecycle.py",
   "app/*migration*",
   "app/*recovery*"
  ]
 },
