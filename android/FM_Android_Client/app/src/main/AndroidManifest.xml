<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application android:label="@string/app_name" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@mipmap/ic_launcher"
        android:theme="@style/FmDark"
        android:usesCleartextTraffic="true" android:supportsRtl="true">
        <activity android:name=".ScannerActivity" android:exported="false" />
        <activity android:name=".FarmActivity" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".CameraActivity" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".NfcCheckActivity" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".BambuReadActivity" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".MainActivity" android:theme="@style/FmLaunch" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
